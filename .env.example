# copy file này thành .env rồi điền key của bạn
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Chỉ cần khi deploy (xem README):
# CORS_ORIGINS=https://ten-app-cua-ban.vercel.app
# TRUST_PROXY=true
# ASK_LIMIT_PER_HOUR=30
# INDEX_LIMIT_PER_HOUR=10

# Đăng nhập Google + lưu lịch sử chat (tùy chọn, bỏ trống thì app chạy chế độ khách):
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# SESSION_SECRET=một-chuỗi-ngẫu-nhiên-dài
# DATABASE_URL=postgresql://user:pass@host/db   # mặc định là file SQLite trong data/
